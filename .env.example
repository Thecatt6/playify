# Playify - Bot Configuration

# [REQUIRED] Discord Bot Token
# Get one at: https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# [OPTIONAL] Spotify Integration
# Get these at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_id
SPOTIFY_CLIENT_SECRET=your_spotify_secret

# [OPTIONAL] Genius Lyrics
# Get one at: https://genius.com/api-clients
GENIUS_TOKEN=your_genius_token

# [OPTIONAL] Web UI — control the bot from a browser
# Only people physically sitting in the same voice channel as the bot get access.
# 1. Open https://discord.com/developers/applications → your app → OAuth2
# 2. Copy the Client ID and Client Secret below
# 3. Add "<WEBUI_BASE_URL>/auth/callback" to the Redirects list
WEBUI_ENABLED=true
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
# Public address of the interface (used to build the OAuth redirect URI)
WEBUI_BASE_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional tuning
# WEBUI_SECRET=                    # signs session cookies (auto-generated in data/webui_secret)
# WEBUI_TRUST_PROXY=true           # honour X-Forwarded-* when behind a reverse proxy
# WEBUI_SESSION_TTL=43200          # session lifetime in seconds (12 hours)
# WEBUI_ALLOW_ANY_ORIGIN=false     # dev/demo only: disables the Origin check
# WEBUI_METRICS_TOKEN=             # set it to require "Authorization: Bearer <token>" on /metrics

# [OPTIONAL] Logging
# Playify always logs to stdout; it also keeps a rotating file (10 MB x 5).
# LOG_LEVEL=INFO
# PLAYIFY_LOG_FILE=logs/playify.log   # "off" keeps stdout only
